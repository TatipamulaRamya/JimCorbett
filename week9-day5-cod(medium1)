# ============================================================
# CELL 2 - TASK 1 - SQL
# Create or Reuse the Assessment Schema
# ============================================================
%sql

CREATE SCHEMA IF NOT EXISTS cat_ltm10877309.exam_ltm10877309;

SHOW SCHEMAS IN cat_ltm10877309;


# ============================================================
# CELL 3 - TASK 2 - PYSPARK
# Read CSV Using Explicit Schema
# ============================================================

from pyspark.sql.types import *

file_path = "/Volumes/cat_ltm10877309/schema_data_integration_tr/m01_mgd_vol/assessments/ltm10877309/m01/M01_Industrial_Asset_Delta_Maintenance.csv"

asset_schema = StructType([
    StructField("asset_id", StringType(), True),
    StructField("region", StringType(), True),
    StructField("asset_type", StringType(), True),
    StructField("quantity", IntegerType(), True),
    StructField("unit_cost", DecimalType(12, 2), True),
    StructField("total_cost", DecimalType(14, 2), True),
    StructField("condition", StringType(), True)
])

asset_df = (
    spark.read
    .option("header", "true")
    .schema(asset_schema)
    .csv(file_path)
)

asset_df.printSchema()

print("Source Record Count:", asset_df.count())

display(asset_df.orderBy("asset_id"))


# ============================================================
# CELL 4 - TASK 2 - PYSPARK
# Write Managed Delta Table
# No Path, Location, Partitioning or Clustering
# ============================================================

table_name = "cat_ltm10877309.exam_ltm10877309.asset_costs"

(
    asset_df.write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(table_name)
)

print("Managed Delta table created:")
print(table_name)

display(
    spark.table(table_name)
    .orderBy("asset_id")
)


