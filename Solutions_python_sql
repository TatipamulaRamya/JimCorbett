    r.finish_time,
    ROUND(
        AVG(r.finish_time) OVER (
            PARTITION BY r.event_id
        ), 2
    ) AS avg_event_time
FROM Results r
JOIN Events e
    ON r.event_id = e.event_id
JOIN Athletes a
