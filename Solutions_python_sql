print(chess.get_player_details("P101"))

print(chess.qualified_players(1800))

#3. Pandas — EV Charging Station Analysis
import pandas as pd


class EVChargingAnalyzer:

    # 1. Create Charging Sessions DataFrame
    def create_sessions_df(self, session_data: list) -> pd.DataFrame:

        columns = [
            "SessionID",
            "StationID",
            "City",
            "ChargingDate",
            "EnergyKWh",
            "DurationMinutes",
            "PaymentStatus"
        ]

        return pd.DataFrame(session_data, columns=columns)


    # 2. Clean Charging Sessions
    def clean_sessions_data(self, df: pd.DataFrame) -> pd.DataFrame:

        df = df.dropna(
            subset=[
                "SessionID",
                "StationID",
                "City",
                "PaymentStatus"
            ]
        )

        df = df[
            (df["EnergyKWh"] > 0) &
            (df["DurationMinutes"] > 0)
        ]

        df = df[
            df["PaymentStatus"].isin(
                ["Paid", "Pending", "Failed"]
            )
        ]

        return df


    # 3. Add Long Session Flag
    def add_long_session_flag(
        self,
        df: pd.DataFrame,
        duration_threshold: int
    ) -> pd.DataFrame:

        df = df.copy()

        df["IsLongSession"] = (
            df["DurationMinutes"] > duration_threshold
        ).astype(int)

        return df


    # 4. Station Utilization Summary
    def station_utilization_summary(
        self,
        df: pd.DataFrame
    ) -> pd.DataFrame:

        result = df.groupby("StationID").agg(
            SessionCount=("SessionID", "count"),
            TotalEnergyKWh=("EnergyKWh", "sum"),
            AverageDuration=("DurationMinutes", "mean")
        ).reset_index()

        result["AverageDuration"] = result["AverageDuration"].round(1)

        return result


    # 5. High Energy Stations
    def high_energy_stations(
        self,
        df: pd.DataFrame,
        energy_threshold: float
    ) -> pd.DataFrame:

        result = (
            df.groupby("StationID")["EnergyKWh"]
            .sum()
            .reset_index()
        )

        result = result.rename(
            columns={"EnergyKWh": "TotalEnergyKWh"}
        )

        result = result[
            result["TotalEnergyKWh"] > energy_threshold
        ]

        return result


    # 6. City Revenue Summary
    def city_revenue_summary(
        self,
        df: pd.DataFrame
    ) -> pd.DataFrame:

        paid_df = df[df["PaymentStatus"] == "Paid"].copy()

        paid_df["Revenue"] = paid_df["EnergyKWh"] * 18

        result = (
            paid_df.groupby("City")["Revenue"]
            .sum()
            .reset_index()
        )

        return result


# Driver Code
analyzer = EVChargingAnalyzer()

data = [
    [501, "ST01", "Bengaluru", "2025-02-01", 42.5, 75, "Paid"],
    [502, "ST02", "Chennai", "2025-02-01", 28.0, 50, "Paid"],
    [503, "ST01", "Bengaluru", "2025-02-02", 55.0, 130, "Pending"]
]

df = analyzer.create_sessions_df(data)

print("Original DataFrame:")
print(df)

cleaned_df = analyzer.clean_sessions_data(df)

print("\nCleaned DataFrame:")
print(cleaned_df)

flagged_df = analyzer.add_long_session_flag(cleaned_df, 90)

print("\nLong Session Flag:")
print(flagged_df)

print("\nStation Utilization:")
print(analyzer.station_utilization_summary(cleaned_df))

print("\nHigh Energy Stations:")
print(analyzer.high_energy_stations(cleaned_df, 80.0))

print("\nCity Revenue:")
print(analyzer.city_revenue_summary(cleaned_df))

