# ============================================================
# CELL 2 - TASK 1 - SQL
# Create/Re-use the Assessment Schema
# ============================================================
%sql

CREATE SCHEMA IF NOT EXISTS cat_ltm10877309.exam_ltm10877309;

SHOW SCHEMAS IN cat_ltm10877309;


# ============================================================
# CELL 3 - TASK 2 - PYSPARK
# Read the Base CSV Using an Explicit Schema
# ============================================================

from pyspark.sql.types import *

base_file_path = "/Volumes/cat_ltm10877309/schema_data_integration_tr/m01_mgd_vol/assessments/ltm10877309/m02/M02_Warehouse_Inventory_Delta_MERGE_and_OPTIMIZE.csv"

inventory_schema = StructType([
    StructField("sku", StringType(), True),
    StructField("warehouse", StringType(), True),
    StructField("category", StringType(), True),
    StructField("units", IntegerType(), True),
    StructField("unit_cost", DecimalType(12, 2), True),
    StructField("stock_value", DecimalType(14, 2), True)
])

base_df = (
    spark.read
    .option("header", "true")
    .schema(inventory_schema)
    .csv(base_file_path)
)

base_df.printSchema()

print("Base Source Count:", base_df.count())

display(base_df.orderBy("sku"))


# ============================================================
# CELL 4 - TASK 2 - PYSPARK
# Write the Baseline Managed Delta Table
# Do Not Give LOCATION or PATH
# ============================================================

table_name = "cat_ltm10877309.exam_ltm10877309.warehouse_inventory"

(
    base_df.write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(table_name)
)

print("Managed Delta table created:")
print(table_name)

display(
    spark.table(table_name)
    .orderBy("sku")
)


