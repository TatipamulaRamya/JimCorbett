changes_file_path = "/Volumes/cat_ltm10877309/schema_data_integration_tr/m01_mgd_vol/assessments/ltm10877309/m02/M02_Warehouse_Inventory_Delta_MERGE_and_OPTIMIZE_changes.csv"

