# ============================================================
# CELL 8 - TASK 3 - PYSPARK
# Register Changes DataFrame as Temporary View
# ============================================================

changes_df.createOrReplaceTempView("inventory_changes")

print("Temporary view created: inventory_changes")

display(
    spark.sql("""
        SELECT *
        FROM inventory_changes
        ORDER BY sku
    """)
)


# ============================================================
# CELL 9 - TASK 3 - SQL
# Execute Delta MERGE
# Existing SKUs Are Updated and New SKUs Are Inserted
# ============================================================
%sql

MERGE INTO cat_ltm10877309.exam_ltm10877309.warehouse_inventory AS target

USING inventory_changes AS source

ON target.sku = source.sku

WHEN MATCHED THEN
UPDATE SET
    target.warehouse = source.warehouse,
    target.category = source.category,
    target.units = source.units,
    target.unit_cost = source.unit_cost,
    target.stock_value = source.stock_value

WHEN NOT MATCHED THEN
INSERT (
    sku,
    warehouse,
    category,
    units,
    unit_cost,
    stock_value
)
VALUES (
    source.sku,
    source.warehouse,
    source.category,
    source.units,
    source.unit_cost,
    source.stock_value
);


# ============================================================
# CELL 10 - TASK 3 - SQL
# Verify Updated and Inserted Records
# ============================================================
%sql

SELECT
    sku,
    warehouse,
    category,
    units,
    unit_cost,
    stock_value
FROM cat_ltm10877309.exam_ltm10877309.warehouse_inventory
WHERE sku IN ('SKU002', 'SKU008', 'SKU013', 'SKU014')
ORDER BY sku;


# Expected:
# SKU002 -> units 7, stock_value 1400.00
# SKU008 -> units 6, stock_value 2400.00
# SKU013 -> units 4, stock_value 600.00
# SKU014 -> units 3, stock_value 750.00


# ============================================================
# CELL 11 - TASK 4 - SQL
# Optimize and Z-Order by Warehouse
# ============================================================
%sql

