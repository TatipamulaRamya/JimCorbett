from pyspark import pipelines as dp
from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    IntegerType,
    DecimalType
)
catalog = "cat_ltm10877309"
schema = "schema_data_integration_tr"
volume = "ext_vol_ramya"
base_path = f"/Volumes/{catalog}/{schema}/{volume}/sdp"
customers_path = f"{base_path}/input/customers.csv"
orders_path = f"{base_path}/input/orders.csv"
customer_schema = StructType([
    StructField("customer_id", StringType(), True),
    StructField("customer_name", StringType(), True),
    StructField("city", StringType(), True)
])
order_schema = StructType([
    StructField("order_id", StringType(), True),
    StructField("customer_id", StringType(), True),
    StructField("order_date", StringType(), True),
    StructField("quantity", IntegerType(), True),
    StructField("unit_price", DecimalType(10, 2), True),
    StructField("order_status", StringType(), True)
])


@dp.materialized_view(name="sdp1_ltm10877309")
def sdp1_ltm10877309():
    return (spark.read.option("header","true").schema(customer_schema).csv(customers_path))

@dp.materialized_view(name="sdp2_ltm10877309")
def sdp2_ltm10877309():

    return (
        spark.read
        .option("header", "true")
        .schema(order_schema)
        .csv(orders_path)
    )
@dp.materialized_view(name="sdp3_ltm10877309")
def sdp3_ltm10877309():

    customers_df = spark.read.table("sdp1_ltm10877309")
    orders_df = spark.read.table("sdp2_ltm10877309")

    final_df = (
        orders_df.alias("o")

        .join(
            customers_df.alias("c"),
            F.col("o.customer_id") == F.col("c.customer_id"),
            "inner"
        )

        .filter(
            F.col("o.order_status") == "COMPLETED"
        )

        .withColumn(
            "city",
            F.upper(F.trim(F.col("c.city")))
        )

        .withColumn(
            "order_date",
            F.to_date(
                F.col("o.order_date"),
                "yyyy-MM-dd"
            )
        )

        .withColumn(
            "order_amount",
            (
                F.col("o.quantity") *
                F.col("o.unit_price")
            ).cast("decimal(12,2)")
        )

        .select(
            F.col("o.order_id").alias("order_id"),
            F.col("o.customer_id").alias("customer_id"),
            F.col("c.customer_name").alias("customer_name"),
            F.col("city"),
            F.col("order_date"),
            F.col("o.quantity").alias("quantity"),
            F.col("o.unit_price").alias("unit_price"),
            F.col("order_amount")
        )
    )

    return final_df
