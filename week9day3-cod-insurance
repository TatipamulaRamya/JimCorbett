CELL 1 (SQL)

CREATE SCHEMA IF NOT EXISTS uc_practice_insurance.claims_ops;

CREATE VOLUME IF NOT EXISTS uc_practice_insurance.claims_ops.raw_claims_vol;


CELL 2 (PYSPARK)

from pyspark.sql import functions as F

df = (
    spark.read
    .option("header", "true")
    .option("inferSchema", "true")
    .csv("/Volumes/uc_practice_insurance/claims_ops/raw_claims_vol/data.csv")
)

print("Raw Count :", df.count())

display(
    df.select(
        F.sum(
            F.when(F.col("claim_amount").isNull(), 1).otherwise(0)
        ).alias("null_claim_amount_count")
    )
)


CELL 3 (PYSPARK)

df_clean = (
    df.filter(F.col("claim_amount").isNotNull())

    .withColumn(
        "settlement_gap",
        F.col("claim_amount") - F.col("approved_amount")
    )

    .withColumn(
        "review_flag",
        F.when(F.col("claim_amount") >= 20000, "HIGH")
        .otherwise("STANDARD")
    )
)

print("Cleaned Count :", df_clean.count())

display(df_clean)


CELL 4 (PYSPARK)

df_clean.write \
.format("delta") \
.mode("overwrite") \
.saveAsTable(
    "uc_practice_insurance.claims_ops.claims_silver"
)


CELL 5 (SQL)

SELECT COUNT(*) AS total_records
FROM uc_practice_insurance.claims_ops.claims_silver;


SELECT
    claim_type,
    COUNT(*) AS claim_count,
    SUM(claim_amount) AS total_claim_amount
FROM uc_practice_insurance.claims_ops.claims_silver
GROUP BY claim_type
ORDER BY claim_type;


CELL 6 (PYSPARK)

df_existing = spark.table(
    "uc_practice_insurance.claims_ops.claims_silver"
)

df_evolved = (
    df_existing
    .withColumn(
        "source_system",
        F.lit("BATCH_CSV")
    )
)

df_evolved.write \
.format("delta") \
.mode("overwrite") \
.option("mergeSchema", "true") \
.saveAsTable(
    "uc_practice_insurance.claims_ops.claims_silver"
)


