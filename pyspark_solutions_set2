#EASY 1 — Precision Agriculture Field Inspection
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, to_date, year, month, avg


# ---------------------------------------------------------
# Function 1: Load Field Inspections
# ---------------------------------------------------------
def load_field_inspections(
    spark: SparkSession,
    path: str
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        inferSchema=True
    )

    df = df.withColumn(
        "inspection_date",
        to_date(col("inspection_date"), "yyyy-MM-dd")
    )

    return df


# ---------------------------------------------------------
# Function 2: Drop Incomplete Inspections
# ---------------------------------------------------------
def drop_incomplete_inspections(
    df: DataFrame
) -> DataFrame:

    return df.dropna(
        subset=[
            "inspection_id",
            "field_id",
            "moisture_level"
        ]
    )


# ---------------------------------------------------------
# Function 3: Fill Missing Inspector
# ---------------------------------------------------------
def fill_missing_inspector(
    df: DataFrame
) -> DataFrame:

    return df.fillna(
        {"inspector_name": "Unknown"}
    )


# ---------------------------------------------------------
# Function 4: Add Inspection Year and Month
# ---------------------------------------------------------
def add_inspection_year_month(
    df: DataFrame
) -> DataFrame:

    df = df.withColumn(
        "inspection_year",
        year(col("inspection_date"))
    )

    df = df.withColumn(
        "inspection_month",
        month(col("inspection_date"))
    )

    return df


# ---------------------------------------------------------
# Function 5: Average Moisture by Crop
# ---------------------------------------------------------
def average_moisture_by_crop(
    df: DataFrame
) -> DataFrame:

    return df.groupBy(
        "crop_type"
    ).agg(
        avg("moisture_level").alias("avg_moisture")
    ).select(
        "crop_type",
        "avg_moisture"
    )

#EASY 2 — Museum Artifact Catalog
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, to_date, year, month, sum


# ---------------------------------------------------------
# Function 1: Load Artifact Data
# ---------------------------------------------------------
def load_artifact_data(
    spark: SparkSession,
    path: str
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        inferSchema=True
    )

    df = df.withColumn(
        "acquisition_date",
        to_date(col("acquisition_date"), "yyyy-MM-dd")
    )

    return df


# ---------------------------------------------------------
# Function 2: Drop Records Without Acquisition Date
# ---------------------------------------------------------
def drop_records_without_acquisition_date(
    df: DataFrame
) -> DataFrame:

    return df.dropna(
        subset=[
            "artifact_id",
            "acquisition_date"
        ]
    )


# ---------------------------------------------------------
# Function 3: Fill Missing Category
# ---------------------------------------------------------
def fill_missing_category(
    df: DataFrame
) -> DataFrame:

    return df.fillna(
        {"category": "Unclassified"}
    )


# ---------------------------------------------------------
# Function 4: Add Acquisition Year and Month
# ---------------------------------------------------------
def add_acquisition_year_month(
    df: DataFrame
) -> DataFrame:

    df = df.withColumn(
        "acquisition_year",
        year(col("acquisition_date"))
    )

    df = df.withColumn(
        "acquisition_month",
        month(col("acquisition_date"))
    )

    return df


# ---------------------------------------------------------
# Function 5: Highest Value Gallery
# ---------------------------------------------------------
def highest_value_gallery(
    df: DataFrame
) -> tuple:

    result = df.groupBy(
        "gallery"
    ).agg(
        sum("estimated_value").alias("total_value")
    )

    result = result.orderBy(
        col("total_value").desc(),
        col("gallery").asc()
    )

    row = result.first()

    if row is None:
        return ("", 0.0)

    return (
        row["gallery"],
        float(row["total_value"])
    )

#MEDIUM 1 — Aircraft Maintenance Compliance Analytics
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType
)
from pyspark.sql.functions import (
    col,
    to_date,
    sum,
    rank
)
from pyspark.sql.window import Window


# ---------------------------------------------------------
# Function 1: Define Maintenance Schema
# ---------------------------------------------------------
def define_maintenance_schema() -> StructType:

    schema = StructType([
        StructField("maintenance_id", StringType(), True),
        StructField("aircraft_id", StringType(), True),
        StructField("maintenance_date", StringType(), True),
        StructField("maintenance_cost", DoubleType(), True),
        StructField("maintenance_status", StringType(), True)
    ])

    return schema


# ---------------------------------------------------------
# Function 2: Load Maintenance Data
# ---------------------------------------------------------
def load_maintenance_data(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        schema=schema
    )

    df = df.withColumn(
        "maintenance_date",
        to_date(
            col("maintenance_date"),
            "yyyy-MM-dd"
        )
    )

    return df


# ---------------------------------------------------------
# Function 3: Join Aircraft With Maintenance
# ---------------------------------------------------------
def join_aircraft_with_maintenance(
    aircraft_df: DataFrame,
    maintenance_df: DataFrame
) -> DataFrame:

    return aircraft_df.join(
        maintenance_df,
        on="aircraft_id",
        how="inner"
    )


# ---------------------------------------------------------
# Function 4: Aircraft Without Maintenance
# ---------------------------------------------------------
def aircraft_without_maintenance(
    aircraft_df: DataFrame,
    maintenance_df: DataFrame
) -> DataFrame:

    return aircraft_df.join(
        maintenance_df,
        on="aircraft_id",
        how="left_anti"
    )


# ---------------------------------------------------------
# Function 5: Rank Aircraft by Maintenance Cost
# ---------------------------------------------------------
def rank_aircraft_by_maintenance_cost(
    df: DataFrame
) -> DataFrame:

    result = df.groupBy(
        "aircraft_model",
        "aircraft_id"
    ).agg(
        sum("maintenance_cost").alias(
            "total_maintenance_cost"
        )
    )

    window = Window.partitionBy(
        "aircraft_model"
    ).orderBy(
        col("total_maintenance_cost").desc()
    )

    result = result.withColumn(
        "maintenance_rank",
        rank().over(window)
    )

    return result.select(
        "aircraft_model",
        "aircraft_id",
        "total_maintenance_cost",
        "maintenance_rank"
    )

#MEDIUM 2 — Film Production Crew Payment Analytics
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType
)
from pyspark.sql.functions import (
    col,
    to_date,
    year,
    month,
    sum,
    rank
)
from pyspark.sql.window import Window


# ---------------------------------------------------------
# Function 1: Define Payment Schema
# ---------------------------------------------------------
def define_payment_schema() -> StructType:

    schema = StructType([
        StructField("payment_id", StringType(), True),
        StructField("crew_id", StringType(), True),
        StructField("payment_date", StringType(), True),
        StructField("payment_amount", DoubleType(), True),
        StructField("payment_status", StringType(), True)
    ])

    return schema


# ---------------------------------------------------------
# Function 2: Load and Clean Payments
# ---------------------------------------------------------
def load_and_clean_payments(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        schema=schema
    )

    # Convert date
    df = df.withColumn(
        "payment_date",
        to_date(
            col("payment_date"),
            "yyyy-MM-dd"
        )
    )

    # Remove incomplete records
    df = df.dropna(
        subset=[
            "payment_id",
            "crew_id",
            "payment_amount"
        ]
    )

    # Fill missing status
    df = df.fillna(
        {"payment_status": "Pending"}
    )

    # Add year
    df = df.withColumn(
        "payment_year",
        year(col("payment_date"))
    )

    # Add month
    df = df.withColumn(
        "payment_month",
        month(col("payment_date"))
    )

    return df


# ---------------------------------------------------------
# Function 3: Join Crew With Payments
# ---------------------------------------------------------
def join_crew_with_payments(
    crew_df: DataFrame,
    payments_df: DataFrame
) -> DataFrame:

    return crew_df.join(
        payments_df,
        on="crew_id",
        how="inner"
    )


# ---------------------------------------------------------
# Function 4: Crew Without Payments
# ---------------------------------------------------------
def crew_without_payments(
    crew_df: DataFrame,
    payments_df: DataFrame
) -> DataFrame:

    return crew_df.join(
        payments_df,
        on="crew_id",
        how="left_anti"
    )


# ---------------------------------------------------------
# Function 5: Rank Crew by Total Payment
# ---------------------------------------------------------
def rank_crew_by_total_payment(
    df: DataFrame
) -> DataFrame:

    result = df.groupBy(
        "department",
        "crew_id",
        "crew_name"
    ).agg(
        sum("payment_amount").alias(
            "total_payment"
        )
    )

    window = Window.partitionBy(
        "department"
    ).orderBy(
        col("total_payment").desc()
    )

    result = result.withColumn(
        "payment_rank",
        rank().over(window)
    )

    return result.select(
        "department",
        "crew_id",
        "crew_name",
        "total_payment",
        "payment_rank"
    )


#Insurance Claims Policy Insights
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType
)
from pyspark.sql.functions import (
    to_date,
    col,
    sum as spark_sum
)

def define_claim_schema() -> StructType:
    return StructType([
        StructField("claim_id", StringType(), True),
        StructField("policy_id", StringType(), True),
        StructField("customer_id", StringType(), True),
        StructField("claim_amount", DoubleType(), True),
        StructField("claim_status", StringType(), True),
        StructField("claim_date", StringType(), True)
    ])

def load_claims_data(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    df = (
        spark.read
        .option("header", True)
        .schema(schema)
        .csv(path)
    )

    df = df.withColumn(
        "claim_date",
        to_date(col("claim_date"), "yyyy-MM-dd")
    )

    return df

def load_policy_data(
    spark: SparkSession,
    path: str
) -> DataFrame:

    return (
        spark.read
        .option("header", True)
        .option("inferSchema", True)
        .csv(path)
    )

def join_claims_with_policies(
    claims_df: DataFrame,
    policies_df: DataFrame
) -> DataFrame:

    return (
        claims_df
        .join(
            policies_df,
            on="policy_id",
            how="inner"
        )
        .select(
            "claim_id",
            "policy_id",
            "customer_id",
            "claim_amount",
            "claim_status",
            "claim_date",
            "policy_type",
            "region",
            "annual_premium"
        )
    )

def policy_type_with_highest_approved_claim_amount(
    df: DataFrame
) -> tuple[str, float]:

    result_df = (
        df
        .filter(col("claim_status") == "Approved")
        .filter(
            col("policy_type").isNotNull()
            & (col("policy_type") != "")
        )
        .filter(col("claim_amount").isNotNull())
        .groupBy("policy_type")
        .agg(
            spark_sum("claim_amount")
            .alias("total_approved_claim_amount")
        )
        .orderBy(
            col("total_approved_claim_amount").desc(),
            col("policy_type").asc()
        )
    )

    row = result_df.first()

    if row is None:
        return ("", 0.0)

    return (
        row["policy_type"],
        float(row["total_approved_claim_amount"])
    )

