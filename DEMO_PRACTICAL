#Question 2 — Will This Work?
WITH Department_Salary AS
(
    SELECT
        department,
        AVG(salary) AS average_salary
    FROM Employees
    GROUP BY department
)

SELECT
    department,
    average_salary
FROM Department_Salary
WHERE average_salary > 60000;
'''✅ Answer:
Yes.
The CTE creates:
department | average_salary
The outer query can then use average_salary.'''
#Question 3 — WILL THIS WORK?
SELECT
    department,
    AVG(salary) AS average_salary
FROM Employees
WHERE average_salary > 60000
GROUP BY department;
'''✅ Answer:
No.
Because average_salary is an aggregate result created by:
AVG(salary)
WHERE operates before aggregation.
The appropriate clause is:
HAVING AVG(salary) > 60000

WHERE → filters rows
GROUP BY → groups rows
HAVING → filters groups'''







