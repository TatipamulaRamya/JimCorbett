'''PART 1 — CASE EXPRESSION
Syntax:
CASE
    WHEN condition1 THEN result1
    WHEN condition2 THEN result2
    WHEN condition3 THEN result3
    ELSE result
END'''


#Example 1:
SELECT
    employee_name,
    salary,
    CASE
        WHEN salary >= 80000 THEN 'High Salary'
        WHEN salary >= 60000 THEN 'Medium Salary'
        ELSE 'Low Salary'
    END AS salary_category
FROM Employees;

#Example 2:
SELECT
    employee_name,
    salary,
    performance_score,
    CASE
        WHEN salary >= 70000 AND performance_score >= 85
            THEN 'Top Performer'
        ELSE 'Regular Performer'
    END AS employee_category
FROM Employees;

'''PART 2 — CTE
SYNTAX:
WITH cte_name AS
(
    SELECT ...
    FROM ...
)
SELECT *
FROM cte_name;'''
#Example:
WITH Department_Salary AS
(
    SELECT
        department,
        AVG(salary) AS average_salary
    FROM Employees
    GROUP BY department
)
SELECT
    department,
    average_salary
FROM Department_Salary
WHERE average_salary > 60000;

#PART 3 — CASE + CTE TOGETHER
WITH Department_Salary AS
(
    SELECT
        department,
        AVG(salary) AS average_salary
    FROM Employees
    GROUP BY department
)
SELECT
    department,
    average_salary,
    CASE
        WHEN average_salary >= 75000 THEN 'High Paying'
        WHEN average_salary >= 60000 THEN 'Medium Paying'
        ELSE 'Low Paying'
    END AS salary_category
FROM Department_Salary;

