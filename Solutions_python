import numpy as np


class AQIAnalyzer:

    def __init__(self):
        pass

    def create_aqi_array(self, values: list) -> np.ndarray:
        return np.array(values, dtype=np.int64)

    def validate_aqi_array(self, arr: np.ndarray) -> bool:
        if arr.size == 0:
            return False

        if not np.issubdtype(arr.dtype, np.number):
            return False

        if np.all((arr >= 0) & (arr <= 100)):
            return True

        return False

    def compute_aqi_stats(self, arr: np.ndarray) -> tuple:
        average = np.mean(arr)
        std = np.std(arr)
        maximum = np.max(arr)
        minimum = np.min(arr)

        return (
            round(average, 2),
            round(std, 2),
            round(maximum, 2),
            round(minimum, 2)
        )

    def categorize_aqi(self, arr: np.ndarray) -> np.ndarray:
        result = np.where(
            arr <= 50, "Good",
            np.where(
                arr <= 100, "Moderate",
                np.where(
                    arr <= 150, "USG",
                    np.where(
                        arr <= 200, "Unhealthy",
                        np.where(
                            arr <= 300, "Very Unhealthy",
                            "Hazardous"
                        )
                    )
                )
            )
        )

        return result

    def longest_unhealthy_streak(self, arr: np.ndarray) -> int:
        unhealthy = arr >= 151

        max_streak = 0
        current_streak = 0

        for value in unhealthy:
            if value:
                current_streak += 1

                if current_streak > max_streak:
                    max_streak = current_streak
            else:
                current_streak = 0

        return max_streak

