import pandas as pd


class ReturnsAnalyzer:

    def __init__(self):
        pass

    def create_orders_df(self, order_data: list) -> pd.DataFrame:
        df = pd.DataFrame(
            order_data,
            columns=["OrderID", "SellerID", "Category", "OrderDate", "OrderAmount"]
        )
        return df

    def create_returns_df(self, return_data: list) -> pd.DataFrame:
        df = pd.DataFrame(
            return_data,
            columns=["OrderID", "ReturnDate", "RefundAmount", "Reason"]
        )
        return df

    def merge_orders_returns(self, orders_df: pd.DataFrame,
                             returns_df: pd.DataFrame) -> pd.DataFrame:
        df = pd.merge(
            orders_df,
            returns_df,
            on="OrderID",
            how="left"
        )
        return df

    def category_refund_rate(self, merged_df: pd.DataFrame) -> pd.DataFrame:
        result = merged_df.groupby("Category").size().reset_index(name="Orders")

        returned = (
            merged_df[merged_df["RefundAmount"].notna()]
            .groupby("Category")
            .size()
            .reset_index(name="ReturnedOrders")
        )

        result = pd.merge(result, returned, on="Category", how="left")

        result["ReturnedOrders"] = result["ReturnedOrders"].fillna(0)

        result["RefundRate"] = (
            result["ReturnedOrders"] / result["Orders"] * 100
        )

        result = result.reset_index(drop=True)
        result = result.sort_values("Category").reset_index(drop=True)

        return result

    def high_return_sellers(self, merged_df: pd.DataFrame, n: int) -> pd.DataFrame:
        returned = merged_df[merged_df["IsReturned"] == 1]

        counts = (
            returned.groupby("SellerID")
            .size()
            .reset_index(name="ReturnCount")
        )

        result = counts[counts["ReturnCount"] > n]

        result = result.reset_index(drop=True)

        return result

    def clean_returns_data(self, returns_df: pd.DataFrame) -> pd.DataFrame:
        df = returns_df.dropna(subset=["Reason"])

        df = df[
            df["RefundAmount"].notna() &
            (df["RefundAmount"] > 0)
        ]

        df = df.reset_index(drop=True)

        return df
