# 34. Min-Max Normalize Fare
def minmax_normalize_fare(
    df: DataFrame
) -> DataFrame:

    row = df.agg(
        F.min("fare").alias("min_fare"),
        F.max("fare").alias("max_fare")
    ).first()

    min_fare = row["min_fare"]
    max_fare = row["max_fare"]

    if (
        min_fare is None or
        max_fare is None or
        max_fare == min_fare
    ):
        return df.withColumn(
            "fare_norm",
            F.lit(0.0)
        )

    return df.withColumn(
        "fare_norm",
        (
            F.col("fare") -
            F.lit(min_fare)
        ) / (
            F.lit(max_fare) -
            F.lit(min_fare)
        )
    )


# 35. Detect Outlier Fares
def detect_outlier_fares(
    df: DataFrame
) -> DataFrame:

    row = df.agg(
        F.avg("fare").alias("mean_fare"),
        F.stddev_pop("fare").alias("std_fare")
    ).first()

    mean_fare = row["mean_fare"]
    std_fare = row["std_fare"]

    if (
        mean_fare is None or
        std_fare is None
    ):
        return df.withColumn(
            "is_outlier",
            F.lit(False)
        )

    threshold = (
        mean_fare +
        2 * std_fare
    )

    return df.withColumn(
        "is_outlier",
        F.col("fare") > F.lit(threshold)
    )


# 36. Monthly Net Revenue By Zone
def monthly_net_revenue_by_zone(
