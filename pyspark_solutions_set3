# 24. Join Profiles With Plans
def join_profiles_with_plans(
    profiles_df: DataFrame,
    plans_df: DataFrame
) -> DataFrame:

    return (
        profiles_df
        .join(
            plans_df,
            on="plan_id",
            how="left"
        )
        .select(
            "user_id",
            "first_name",
            "last_name",
            "full_name",
            "plan_id",
            "plan_name"
        )
    )


# 25. Enrich Full Name
def enrich_full_name(
    profile_joined_df: DataFrame
) -> DataFrame:

    return profile_joined_df.withColumn(
        "full_name",
        F.when(
            F.col("full_name").isNull() |
            (
                F.length(
                    F.trim(
                        F.col("full_name")
                    )
                ) == 0
            ),
            F.concat_ws(
                " ",
                F.col("first_name"),
                F.col("last_name")
            )
        ).otherwise(
            F.col("full_name")
        )
    )


