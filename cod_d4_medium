premium_count_df = spark.sql("""
SELECT
    COUNT(*) AS premium_row_count
FROM cat_ltm10877309.schema_data_integration_tr.delivery_silver
WHERE fee_tier = 'PREMIUM'
""")

display(premium_count_df)
