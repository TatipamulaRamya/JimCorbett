#SQL QUESTION AND ANSWERS
#Q1
SELECT
    o.order_id,
    c.name AS customer_name,
    o.total_amount
FROM Orders o
JOIN Customers c
    ON o.customer_id = c.customer_id
WHERE o.total_amount = (
    SELECT MAX(total_amount)
    FROM Orders
);

#Q2
select
s.student_id,
s.name as student_name,
c.course_id,
c.course_name,
e.grade,
d.department_name
from Enrollments e 
join Students s 
on s.student_id=e.student_id
join Courses c 
on c.course_id=e.course_id
join Departments d 
on d.department_id=c.department_id;

#Q3
SELECT 
c.course_name,
avg(s.score) as avg_score
from Assignments a  
join Submissions s  
on s.assignment_id=a.assignment_id
join Courses c  
on a.course_id=c.course_id
group by 
c.course_id,
c.course_name
order by 
avg_score desc ;

#Q4
select 
department_name,
doctor_name,
total_revenue,
rank() over(
partition by dept_id
order by total_revenue desc)
as revenue_rank
from(
select 
d.dept_id,
d.department_name,
do.doctor_name,
sum(b.amount) as total_revenue
from Doctors do 
join Departments d 
on d.dept_id=do.dept_id
join Appointments a 
on a.doctor_id=do.doctor_id
join Bills b 
on b.appointment_id=a.appointment_id
group by 
d.dept_id,
d.department_name,
do.doctor_name) as revenuetab;

#Q5
SELECT
    student_id,
    name,
    course_count,
    RANK() OVER (
        ORDER BY course_count DESC
    ) AS rank_by_enrollments,
    DENSE_RANK() OVER (
        ORDER BY course_count DESC
    ) AS dense_rank_by_enrollments
FROM (
    SELECT
        s.student_id,
        s.name,
        COUNT(e.course_id) AS course_count
    FROM Students s
    JOIN Enrollments e
        ON s.student_id = e.student_id
    GROUP BY s.student_id, s.name
) AS student_courses
ORDER BY rank_by_enrollments;

#Q6
SELECT DISTINCT
    m.movie_id,
    m.title
FROM Movies m
JOIN Watch_History wh
    ON m.movie_id = wh.movie_id
WHERE wh.user_id IN (
    SELECT user_id
    FROM Watch_History
    WHERE movie_id = (
        SELECT movie_id
        FROM Movies
        WHERE title = 'Life of Pi'
    )
)
ORDER BY m.movie_id;
