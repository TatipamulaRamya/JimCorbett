#EASY 1 — Precision Agriculture Field Inspection
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, to_date, year, month, avg


# ---------------------------------------------------------
# Function 1: Load Field Inspections
# ---------------------------------------------------------
def load_field_inspections(
    spark: SparkSession,
    path: str
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        inferSchema=True
    )

    df = df.withColumn(
        "inspection_date",
        to_date(col("inspection_date"), "yyyy-MM-dd")
    )

    return df


# ---------------------------------------------------------
# Function 2: Drop Incomplete Inspections
# ---------------------------------------------------------
def drop_incomplete_inspections(
    df: DataFrame
) -> DataFrame:

    return df.dropna(
        subset=[
            "inspection_id",
            "field_id",
            "moisture_level"
        ]
    )


# ---------------------------------------------------------
# Function 3: Fill Missing Inspector
# ---------------------------------------------------------
def fill_missing_inspector(
    df: DataFrame
) -> DataFrame:

    return df.fillna(
        {"inspector_name": "Unknown"}
    )


# ---------------------------------------------------------
# Function 4: Add Inspection Year and Month
# ---------------------------------------------------------
def add_inspection_year_month(
    df: DataFrame
) -> DataFrame:

    df = df.withColumn(
        "inspection_year",
        year(col("inspection_date"))
    )

    df = df.withColumn(
        "inspection_month",
        month(col("inspection_date"))
    )

    return df


# ---------------------------------------------------------
# Function 5: Average Moisture by Crop
# ---------------------------------------------------------
def average_moisture_by_crop(
    df: DataFrame
) -> DataFrame:

    return df.groupBy(
        "crop_type"
    ).agg(
        avg("moisture_level").alias("avg_moisture")
    ).select(
        "crop_type",
        "avg_moisture"
    )

#EASY 2 — Museum Artifact Catalog
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col, to_date, year, month, sum


# ---------------------------------------------------------
# Function 1: Load Artifact Data
# ---------------------------------------------------------
def load_artifact_data(
    spark: SparkSession,
    path: str
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        inferSchema=True
    )

    df = df.withColumn(
        "acquisition_date",
        to_date(col("acquisition_date"), "yyyy-MM-dd")
    )

    return df


# ---------------------------------------------------------
# Function 2: Drop Records Without Acquisition Date
# ---------------------------------------------------------
def drop_records_without_acquisition_date(
    df: DataFrame
) -> DataFrame:

    return df.dropna(
        subset=[
            "artifact_id",
            "acquisition_date"
        ]
    )


# ---------------------------------------------------------
# Function 3: Fill Missing Category
# ---------------------------------------------------------
def fill_missing_category(
    df: DataFrame
) -> DataFrame:

    return df.fillna(
        {"category": "Unclassified"}
    )


# ---------------------------------------------------------
# Function 4: Add Acquisition Year and Month
# ---------------------------------------------------------
def add_acquisition_year_month(
    df: DataFrame
) -> DataFrame:

    df = df.withColumn(
        "acquisition_year",
        year(col("acquisition_date"))
    )

    df = df.withColumn(
        "acquisition_month",
        month(col("acquisition_date"))
    )

    return df


# ---------------------------------------------------------
# Function 5: Highest Value Gallery
# ---------------------------------------------------------
def highest_value_gallery(
    df: DataFrame
) -> tuple:

    result = df.groupBy(
        "gallery"
    ).agg(
        sum("estimated_value").alias("total_value")
    )

    result = result.orderBy(
        col("total_value").desc(),
        col("gallery").asc()
    )

    row = result.first()

    if row is None:
        return ("", 0.0)

    return (
        row["gallery"],
        float(row["total_value"])
    )

#MEDIUM 1 — Aircraft Maintenance Compliance Analytics
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType
)
from pyspark.sql.functions import (
    col,
    to_date,
    sum,
    rank
)
from pyspark.sql.window import Window


# ---------------------------------------------------------
# Function 1: Define Maintenance Schema
# ---------------------------------------------------------
def define_maintenance_schema() -> StructType:

    schema = StructType([
        StructField("maintenance_id", StringType(), True),
        StructField("aircraft_id", StringType(), True),
        StructField("maintenance_date", StringType(), True),
        StructField("maintenance_cost", DoubleType(), True),
        StructField("maintenance_status", StringType(), True)
    ])

    return schema


# ---------------------------------------------------------
# Function 2: Load Maintenance Data
# ---------------------------------------------------------
def load_maintenance_data(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        schema=schema
    )

    df = df.withColumn(
        "maintenance_date",
        to_date(
            col("maintenance_date"),
            "yyyy-MM-dd"
        )
    )

    return df


# ---------------------------------------------------------
# Function 3: Join Aircraft With Maintenance
# ---------------------------------------------------------
def join_aircraft_with_maintenance(
    aircraft_df: DataFrame,
    maintenance_df: DataFrame
) -> DataFrame:

    return aircraft_df.join(
        maintenance_df,
        on="aircraft_id",
        how="inner"
    )


# ---------------------------------------------------------
# Function 4: Aircraft Without Maintenance
# ---------------------------------------------------------
def aircraft_without_maintenance(
    aircraft_df: DataFrame,
    maintenance_df: DataFrame
) -> DataFrame:

    return aircraft_df.join(
        maintenance_df,
        on="aircraft_id",
        how="left_anti"
    )


# ---------------------------------------------------------
# Function 5: Rank Aircraft by Maintenance Cost
# ---------------------------------------------------------
def rank_aircraft_by_maintenance_cost(
    df: DataFrame
) -> DataFrame:

    result = df.groupBy(
        "aircraft_model",
        "aircraft_id"
    ).agg(
        sum("maintenance_cost").alias(
            "total_maintenance_cost"
        )
    )

    window = Window.partitionBy(
        "aircraft_model"
    ).orderBy(
        col("total_maintenance_cost").desc()
    )

    result = result.withColumn(
        "maintenance_rank",
        rank().over(window)
    )

    return result.select(
        "aircraft_model",
        "aircraft_id",
        "total_maintenance_cost",
        "maintenance_rank"
    )

#MEDIUM 2 — Film Production Crew Payment Analytics
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType
)
from pyspark.sql.functions import (
    col,
    to_date,
    year,
    month,
    sum,
    rank
)
from pyspark.sql.window import Window


# ---------------------------------------------------------
# Function 1: Define Payment Schema
# ---------------------------------------------------------
def define_payment_schema() -> StructType:

    schema = StructType([
        StructField("payment_id", StringType(), True),
        StructField("crew_id", StringType(), True),
        StructField("payment_date", StringType(), True),
        StructField("payment_amount", DoubleType(), True),
        StructField("payment_status", StringType(), True)
    ])

    return schema


# ---------------------------------------------------------
# Function 2: Load and Clean Payments
# ---------------------------------------------------------
def load_and_clean_payments(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    df = spark.read.csv(
        path,
        header=True,
        schema=schema
    )

    # Convert date
    df = df.withColumn(
        "payment_date",
        to_date(
            col("payment_date"),
            "yyyy-MM-dd"
        )
    )

    # Remove incomplete records
    df = df.dropna(
        subset=[
            "payment_id",
            "crew_id",
            "payment_amount"
        ]
    )

    # Fill missing status
    df = df.fillna(
        {"payment_status": "Pending"}
    )

    # Add year
    df = df.withColumn(
        "payment_year",
        year(col("payment_date"))
    )

    # Add month
    df = df.withColumn(
        "payment_month",
        month(col("payment_date"))
    )

    return df


# ---------------------------------------------------------
# Function 3: Join Crew With Payments
# ---------------------------------------------------------
def join_crew_with_payments(
    crew_df: DataFrame,
    payments_df: DataFrame
) -> DataFrame:

    return crew_df.join(
        payments_df,
        on="crew_id",
        how="inner"
    )


# ---------------------------------------------------------
# Function 4: Crew Without Payments
# ---------------------------------------------------------
def crew_without_payments(
    crew_df: DataFrame,
    payments_df: DataFrame
) -> DataFrame:

    return crew_df.join(
        payments_df,
        on="crew_id",
        how="left_anti"
    )


# ---------------------------------------------------------
# Function 5: Rank Crew by Total Payment
# ---------------------------------------------------------
def rank_crew_by_total_payment(
    df: DataFrame
) -> DataFrame:

    result = df.groupBy(
        "department",
        "crew_id",
        "crew_name"
    ).agg(
        sum("payment_amount").alias(
            "total_payment"
        )
    )

    window = Window.partitionBy(
        "department"
    ).orderBy(
        col("total_payment").desc()
    )

    result = result.withColumn(
        "payment_rank",
        rank().over(window)
    )

    return result.select(
        "department",
        "crew_id",
        "crew_name",
        "total_payment",
        "payment_rank"
    )

#Q777 — Clinic Appointment Wait-Time Assessment
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType
)


# ============================================================
# 1. Load Appointment Data
# ============================================================

def load_appointment_data(
    spark: SparkSession
) -> DataFrame:

    schema = StructType([
        StructField(
            "appointment_id",
            StringType(),
            True
        ),
        StructField(
            "patient_id",
            StringType(),
            True
        ),
        StructField(
            "doctor",
            StringType(),
            True
        ),
        StructField(
            "department",
            StringType(),
            True
        ),
        StructField(
            "scheduled_time",
            StringType(),
            True
        ),
        StructField(
            "actual_time",
            StringType(),
            True
        ),
        StructField(
            "wait_reason",
            StringType(),
            True
        )
    ])

    return spark.read.csv(
        "data/appointments.csv",
        header=True,
        schema=schema
    )


# ============================================================
# 2. Append Wait Minutes
# ============================================================

def append_wait_minutes(
    df: DataFrame
) -> DataFrame:

    scheduled = F.to_timestamp(
        F.col("scheduled_time"),
        "yyyy-MM-dd HH:mm:ss"
    )

    actual = F.to_timestamp(
        F.col("actual_time"),
        "yyyy-MM-dd HH:mm:ss"
    )

    wait_seconds = (
        F.unix_timestamp(actual) -
        F.unix_timestamp(scheduled)
    )

    wait_minutes = F.floor(
        wait_seconds / 60
    )

    return df.withColumn(
        "wait_minutes",
        wait_minutes.cast("int")
    )


# ============================================================
# 3. Get Long Wait Appointments
# ============================================================

def get_long_wait_appointments(
    df: DataFrame,
    threshold_minutes: int
) -> DataFrame:

    df = append_wait_minutes(df)

    return df.filter(
        F.col("wait_minutes") >
        threshold_minutes
    )


# ============================================================
# 4. Most Delayed Doctor
# ============================================================

def most_delayed_doctor(
    df_with_wait: DataFrame
) -> DataFrame:

    return (
        df_with_wait
        .groupBy("doctor")
        .agg(
            F.sum("wait_minutes").alias(
                "total_wait"
            )
        )
        .orderBy(
            F.col("total_wait").desc(),
            F.col("doctor").asc()
        )
        .limit(1)
    )


# ============================================================
# 5. Long Wait Percentage
# ============================================================

def long_wait_percentage(
    df_with_wait: DataFrame
) -> float:

    total_count = df_with_wait.count()

    if total_count == 0:
        return 0.0

    long_count = (
        df_with_wait
        .filter(
            F.col("wait_minutes") > 30
        )
        .count()
    )

    percentage = (
        long_count /
        total_count
    ) * 100

    return float(percentage)


# ============================================================
# 6. Most Delayed Appointment
# ============================================================

def most_delayed_appointment(
    df_with_wait: DataFrame
) -> tuple[str, int]:

    row = (
        df_with_wait
        .select(
            "appointment_id",
            "wait_minutes"
        )
        .orderBy(
            F.col("wait_minutes").desc(),
            F.col("appointment_id").asc()
        )
        .first()
    )

    if row is None:
        return ("", 0)

    return (
        str(row["appointment_id"]),
        int(row["wait_minutes"])
    )


# ============================================================
# 7. Average Wait By Department
# ============================================================

def avg_wait_by_department(
    df_with_wait: DataFrame
) -> DataFrame:

    return (
        df_with_wait
        .groupBy("department")
        .agg(
            F.avg("wait_minutes").alias(
                "avg_wait_minutes"
            )
        )
        .orderBy(
            F.col("avg_wait_minutes").desc(),
            F.col("department").asc()
        )
    )


# ============================================================
# 8. Top N Patients By Wait
# ============================================================

def top_n_patients_by_wait(
    df_with_wait: DataFrame,
    n: int
) -> DataFrame:

    return (
        df_with_wait
        .groupBy("patient_id")
        .agg(
            F.sum("wait_minutes").alias(
                "total_wait_minutes"
            )
        )
        .orderBy(
            F.col("total_wait_minutes").desc(),
            F.col("patient_id").asc()
        )
        .limit(n)
    )


# ============================================================
# 9. Wait Reason Counts
# ============================================================

def wait_reason_counts(
    df: DataFrame
) -> DataFrame:

    return (
        df.groupBy("wait_reason")
        .agg(
            F.count("*").alias(
                "reason_count"
            )
        )
        .orderBy(
            F.col("reason_count").desc(),
            F.col("wait_reason").asc()
        )
        .select(
            "wait_reason",
            "reason_count"
        )
    )


