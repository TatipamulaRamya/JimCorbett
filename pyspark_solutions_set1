        plans_rows,
        schema=plan_schema
    )

    return profiles_df, plans_df


# ============================================================
# 24. JOIN PROFILE + PLAN
# ============================================================

def join_profile_plan(
    profiles_df: DataFrame,
    plans_df: DataFrame
) -> DataFrame:

    return (
        profiles_df.alias("p")
        .join(
            plans_df.alias("pl"),
            F.col("p.plan_id") == F.col("pl.plan_id"),
            "left"
        )
        .select(
            F.col("p.user_id").alias("user_id"),
            F.col("p.first_name").alias("first_name"),
            F.col("p.last_name").alias("last_name"),
            F.col("p.full_name").alias("full_name"),
            F.col("p.plan_id").alias("plan_id"),
            F.col("pl.plan_name").alias("plan_name")
        )
    )


# ============================================================
# 25. ENRICH FULL NAME
# ============================================================

def enrich_full_name(
    profile_joined_df: DataFrame
) -> DataFrame:

    return profile_joined_df.withColumn(
        "full_name",
        F.when(
            F.col("full_name").isNull(),
            F.concat_ws(
                " ",
                F.col("first_name"),
                F.col("last_name")
            )
        ).otherwise(
            F.col("full_name")
        )
    )


# ============================================================
# 26. ADD EVENT EPOCH SECONDS
# ============================================================

def add_event_epoch_seconds(
    df: DataFrame
) -> DataFrame:

    return df.withColumn(
        "event_epoch_seconds",
        F.unix_timestamp(
            F.col("event_date")
        )
    )


# ============================================================
# 27. ADD EVENT TIMESTAMP FROM EPOCH
# ============================================================

def add_event_ts_from_epoch(
    epoch_df: DataFrame
) -> DataFrame:

    return epoch_df.withColumn(
        "event_ts",
        F.from_unixtime(
            F.col("event_epoch_seconds")
        ).cast("timestamp")
    )
