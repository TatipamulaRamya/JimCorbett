# ============================================================
# 24. join_profile_plan
# ============================================================

def join_profile_plan(
    profiles_df: DataFrame,
    plans_df: DataFrame
) -> DataFrame:

    return (
        profiles_df
        .join(
            plans_df,
            profiles_df["plan_id"] == plans_df["plan_id"],
            "left"
        )
        .select(
            profiles_df["user_id"],
            profiles_df["first_name"],
            profiles_df["last_name"],
            profiles_df["full_name"],
            profiles_df["plan_id"],
            plans_df["plan_name"]
        )
    )


# ============================================================
# 25. enrich_full_name
# ============================================================

def enrich_full_name(
    profile_joined_df: DataFrame
) -> DataFrame:

    return profile_joined_df.withColumn(
        "full_name",
        coalesce(
            col("full_name"),
            concat_ws(
                " ",
                col("first_name"),
                col("last_name")
            )
        )
    )


# ============================================================
# 26. add_event_epoch_seconds
# ============================================================

def add_event_epoch_seconds(
    df: DataFrame
) -> DataFrame:

    return df.withColumn(
        "event_epoch_seconds",
        unix_timestamp(
            col("event_date").cast("string"),
            "yyyy-MM-dd"
        )
    )


# ============================================================
# 27. add_event_ts_from_epoch
# ============================================================

def add_event_ts_from_epoch(
    epoch_df: DataFrame
) -> DataFrame:

    return epoch_df.withColumn(
        "event_ts",
        from_unixtime(
            col("event_epoch_seconds")
        ).cast("timestamp")
    )
