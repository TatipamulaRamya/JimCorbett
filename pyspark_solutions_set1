# ============================================================
# 24. JOIN PROFILE + PLAN
# ============================================================

def join_profile_plan(
    profiles_df: DataFrame,
    plans_df: DataFrame
) -> DataFrame:

    return (
        profiles_df
        .join(
            plans_df,
            on="plan_id",
            how="left"
        )
        .select(
            "user_id",
            "first_name",
            "last_name",
            "full_name",
            "plan_id",
            "plan_name"
        )
    )


# ============================================================
# 25. ENRICH FULL NAME
# ============================================================

def enrich_full_name(
    profile_joined_df: DataFrame
) -> DataFrame:

    return profile_joined_df.withColumn(
        "full_name",
        F.when(
            F.col("full_name").isNull(),
            F.concat_ws(
                " ",
                F.col("first_name"),
                F.col("last_name")
            )
        ).otherwise(
            F.col("full_name")
        )
    )


# ============================================================
# 26. ADD EVENT EPOCH SECONDS
# ============================================================

def add_event_epoch_seconds(
    df: DataFrame
) -> DataFrame:

    return df.withColumn(
        "event_epoch_seconds",
        F.unix_timestamp(
            F.col("event_date"),
            "yyyy-MM-dd"
        ).cast("long")
    )


# ============================================================
# 27. ADD EVENT TIMESTAMP FROM EPOCH
# ============================================================

def add_event_ts_from_epoch(
    epoch_df: DataFrame
) -> DataFrame:

    return epoch_df.withColumn(
        "event_ts",
        F.from_unixtime(
            F.col("event_epoch_seconds")
        ).cast("timestamp")
    )
