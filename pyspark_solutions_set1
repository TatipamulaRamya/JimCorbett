#Q402 Telecom Usage & Profile Enrichment
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import *
from pyspark.sql.functions import *


# ============================================================
# 1. define_schema
# ============================================================

def define_schema() -> StructType:

    return StructType([
        StructField("event_id", StringType(), True),
        StructField("user_id", IntegerType(), True),
        StructField("plan", StringType(), True),
        StructField("city", StringType(), True),
        StructField("event_date", StringType(), True),
        StructField("data_mb", DoubleType(), True),
        StructField("voice_minutes", DoubleType(), True),
        StructField("sms_count", IntegerType(), True),
        StructField("roaming", StringType(), True),
        StructField("device_type", StringType(), True),
        StructField("dropped_calls", IntegerType(), True),
        StructField("latency_ms", IntegerType(), True)
    ])


# ============================================================
# 2. load_data
# ============================================================

def load_data(
    spark: SparkSession,
    path: str,
    schema: StructType
) -> DataFrame:

    return spark.read.csv(
        path,
        header=True,
        schema=schema
    )


# ============================================================
# 3. parse_event_date
# ============================================================

def parse_event_date(df: DataFrame) -> DataFrame:

    return df.withColumn(
        "event_date",
        to_date(
            col("event_date"),
            "yyyy-MM-dd"
        )
    )


# ============================================================
# 4. add_total_activity
# ============================================================

def add_total_activity(df: DataFrame) -> DataFrame:

    return df.withColumn(
        "total_activity",
        col("voice_minutes") + col("sms_count")
    )


# ============================================================
# 5. add_usage_score
# ============================================================

def add_usage_score(df: DataFrame) -> DataFrame:

    return df.withColumn(
        "usage_score",
        col("data_mb")
        + (col("voice_minutes") * 0.5)
        + (col("sms_count") * 0.1)
    )


# ============================================================
# 6. filter_roaming_events
# ============================================================

def filter_roaming_events(df: DataFrame) -> DataFrame:

    return df.filter(
        col("roaming") == "Y"
    )


# ============================================================
# 7. top_n_users_by_data
# ============================================================

def top_n_users_by_data(
    df: DataFrame,
    n: int
) -> DataFrame:

    return (
        df.groupBy("user_id")
        .agg(
            sum("data_mb").alias("total_data_mb")
        )
        .orderBy(
            col("total_data_mb").desc(),
            col("user_id").asc()
        )
        .limit(n)
    )


# ============================================================
# 8. avg_latency_by_city
# ============================================================

def avg_latency_by_city(df: DataFrame) -> DataFrame:

    return (
        df.groupBy("city")
        .agg(
            avg("latency_ms").alias("avg_latency_ms")
        )
    )


# ============================================================
# 9. most_used_plan
# ============================================================

def most_used_plan(df: DataFrame) -> str:

    result = (
        df.groupBy("plan")
        .count()
        .orderBy(
            col("count").desc(),
            col("plan").asc()
        )
        .first()
    )

    if result is None:
        return ""

    return result["plan"]


# ============================================================
# 10. dropped_call_rate_by_plan
# ============================================================

def dropped_call_rate_by_plan(df: DataFrame) -> DataFrame:

    return (
        df.groupBy("plan")
        .agg(
            (
                sum("dropped_calls") / count("*")
            ).alias("dropped_call_rate")
        )
        .select(
            "plan",
            "dropped_call_rate"
        )
    )


# ============================================================
# 11. high_latency_events
# ============================================================

def high_latency_events(
    df: DataFrame,
    threshold: int
) -> DataFrame:

    return df.filter(
        col("latency_ms") > threshold
    )


# ============================================================
# 12. count_users_per_city
# ============================================================

def count_users_per_city(df: DataFrame) -> DataFrame:

    return (
        df.groupBy("city")
        .agg(
            countDistinct("user_id").alias("user_count")
        )
        .select(
            "city",
            "user_count"
        )
    )


# ============================================================
# 13. daily_data_trend
# ============================================================

def daily_data_trend(df: DataFrame) -> DataFrame:

    return (
        df.groupBy("event_date")
        .agg(
            sum("data_mb").alias("daily_data_mb")
        )
        .orderBy(
            col("event_date").asc()
        )
    )


# ============================================================
# 14. top_device_by_usage_score
# ============================================================

def top_device_by_usage_score(df: DataFrame) -> str:

    result = (
        df.groupBy("device_type")
        .agg(
            avg("usage_score").alias("avg_usage_score")
        )
        .orderBy(
            col("avg_usage_score").desc(),
            col("device_type").asc()
        )
        .first()
    )

    if result is None:
        return ""

    return result["device_type"]


# ============================================================
# 15. list_cities
# ============================================================

def list_cities(df: DataFrame) -> list:

    rows = (
        df.select("city")
        .distinct()
        .orderBy("city")
        .collect()
    )

    return [row["city"] for row in rows]


# ============================================================
# 16. events_in_date_range
# ============================================================

def events_in_date_range(
    df: DataFrame,
    start: str,
    end: str
) -> DataFrame:

    return df.filter(
        col("event_date").between(
            to_date(lit(start), "yyyy-MM-dd"),
            to_date(lit(end), "yyyy-MM-dd")
        )
    )


# ============================================================
# 17. flag_network_risk
# ============================================================

def flag_network_risk(
    df: DataFrame,
    latency_threshold: int,
    drop_threshold: int
) -> DataFrame:

    return df.withColumn(
        "is_risky",
        (
            (col("latency_ms") > latency_threshold)
            |
            (col("dropped_calls") > drop_threshold)
        )
    )


# ============================================================
# 18. top_n_risky_users
# ============================================================

def top_n_risky_users(
    df: DataFrame,
    n: int
) -> DataFrame:

    return (
        df.filter(
            col("is_risky") == True
        )
        .groupBy("user_id")
        .agg(
            count("*").alias("risky_event_count")
        )
        .orderBy(
            col("risky_event_count").desc(),
            col("user_id").asc()
        )
        .limit(n)
    )


# ============================================================
# 19. avg_data_per_plan
# ============================================================

def avg_data_per_plan(df: DataFrame) -> DataFrame:

    return (
        df.groupBy("plan")
        .agg(
            avg("data_mb").alias("avg_data_mb")
        )
    )


# ============================================================
# 20. get_heaviest_user
# ============================================================

def get_heaviest_user(df: DataFrame) -> tuple:

    result = (
        df.groupBy("user_id")
        .agg(
            sum("data_mb").alias("total_data_mb")
        )
        .orderBy(
            col("total_data_mb").desc(),
            col("user_id").asc()
        )
        .first()
    )

    if result is None:
        return (None, 0.0)

    return (
        result["user_id"],
        float(result["total_data_mb"])
    )


# ============================================================
# 21. define_profile_schema
# ============================================================

def define_profile_schema() -> StructType:

    return StructType([
        StructField("user_id", IntegerType(), True),
        StructField("first_name", StringType(), True),
        StructField("last_name", StringType(), True),
        StructField("full_name", StringType(), True),
        StructField("plan_id", StringType(), True)
    ])


# ============================================================
# 22. define_plan_schema
# ============================================================

def define_plan_schema() -> StructType:

    return StructType([
        StructField("plan_id", StringType(), True),
        StructField("plan_name", StringType(), True)
    ])


# ============================================================
# 23. load_inline_profile_data
# ============================================================

def load_inline_profile_data(
