# CELL 1 - Stage and inspect

from pyspark.sql.types import StructType, StructField, StringType, IntegerType, DoubleType, DateType
from pyspark.sql.functions import col

file_path = "/Volumes/cat_ltm10877309/schema_data_integration_tr/e01_mgd_vol/hotel_bookings.csv"

booking_schema = StructType([
    StructField("booking_id", StringType(), True),
    StructField("hotel_id", StringType(), True),
    StructField("room_type", StringType(), True),
    StructField("nights", IntegerType(), True),
    StructField("nightly_rate", DoubleType(), True),
    StructField("booking_status", StringType(), True),
    StructField("booking_date", DateType(), True)
])

raw_df = (
    spark.read
    .option("header", "true")
    .option("dateFormat", "yyyy-MM-dd")
    .schema(booking_schema)
    .csv(file_path)
)

print("CSV Volume Path:", file_path)
print("Raw Count:", raw_df.count())
raw_df.printSchema()

display(raw_df.filter(col("nightly_rate").isNull()))


# CELL 2 - Filter and calculate booking revenue

from pyspark.sql.functions import round, when

clean_df = (
    raw_df
    .filter(
        col("nightly_rate").isNotNull()
        & (col("nights") > 0)
        & (col("booking_status") == "CONFIRMED")
    )
    .withColumn(
        "booking_amount",
        round(col("nights") * col("nightly_rate"), 2)
    )
    .withColumn(
        "revenue_band",
        when(col("booking_amount") >= 12000, "PREMIUM")
        .otherwise("REGULAR")
    )
)

print("Clean Count:", clean_df.count())

display(
    clean_df.select(
        "booking_id",
        "hotel_id",
        "room_type",
        "nights",
        "nightly_rate",
        "booking_status",
        "booking_date",
        "booking_amount",
        "revenue_band"
    )
)


# CELL 3 - Publish managed Delta table

table_name = "training_assessment.hospitality.booking_silver"

(
    clean_df.write
    .format("delta")
    .mode("overwrite")
    .option("overwriteSchema", "true")
    .saveAsTable(table_name)
)

print("Managed Delta Table:", table_name)

saved_df = spark.table(table_name)

saved_df.printSchema()
display(saved_df)


