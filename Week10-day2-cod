CREATE CATALOG IF NOT EXISTS fashion_catalog;

USE CATALOG fashion_catalog;

CREATE SCHEMA IF NOT EXISTS retail;

USE SCHEMA retail;
file_path = "/Volumes/fashion_catalog/retail/your_volume/apparel_sales.csv"

df = spark.read.format("csv") \
    .option("header", "true") \
    .option("inferSchema", "true") \
    .option("mode", "PERMISSIVE") \
    .load(file_path)

display(df)
df.printSchema()

print(df.columns)

display(df.limit(10))
df.write.format("delta") \
    .mode("overwrite") \
    .option("overwriteSchema", "true") \
    .saveAsTable("fashion_catalog.retail.apparel_sales")
SELECT *
FROM fashion_catalog.retail.apparel_sales;

SELECT
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_sales
FROM fashion_catalog.retail.apparel_sales;

SELECT
    category,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY category
ORDER BY total_revenue DESC;

SELECT
    brand,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY brand
ORDER BY total_revenue DESC
LIMIT 10;

SELECT
    city,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY city
ORDER BY total_revenue DESC;

SELECT
    ROUND(AVG(selling_price), 2) AS average_selling_price
FROM fashion_catalog.retail.apparel_sales;

SELECT
    product_name,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY product_name
ORDER BY total_revenue DESC
LIMIT 10;

SELECT
    CAST(sale_date AS DATE) AS sales_date,
    ROUND(SUM(quantity_sold * selling_price), 2) AS daily_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY CAST(sale_date AS DATE)
ORDER BY sales_date;

SELECT
    city,
    category,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue
FROM fashion_catalog.retail.apparel_sales
GROUP BY city, category
ORDER BY city, total_revenue DESC;

SELECT
    category,
    SUM(quantity_sold) AS total_quantity
FROM fashion_catalog.retail.apparel_sales
GROUP BY category
ORDER BY total_quantity DESC;

SELECT
    brand,
    COUNT(*) AS number_of_records,
    SUM(quantity_sold) AS total_quantity,
    ROUND(SUM(quantity_sold * selling_price), 2) AS total_revenue,
    ROUND(AVG(selling_price), 2) AS average_selling_price
FROM fashion_catalog.retail.apparel_sales
GROUP BY brand
ORDER BY total_revenue DESC;
